# Copy to .env and fill in. Never commit .env or real keys.
# Endpoint and model ID are public values from dev.meta.ai (Session 7).

# API key for the Meta model API. Sent as a Bearer token.
META_API_KEY=

# Model ID to request.
META_MODEL=muse-spark-1.3

# API base URL.
META_BASE_URL=https://api.meta.ai/v1

# Resolver client: fake (canned replies, default) or meta (live API calls).
RESOLVER_CLIENT=fake
